PORT=5001
# docker-compose overrides this to mongodb://mongo:27017/ndmc-mobile
DB_CONNECTION=mongodb://mongo:27017/ndmc-mobile
ACCESS_TOKEN_SECRET=replace-with-long-random-secret
API_KEY=replace-with-api-key
GOOGLE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-android-oauth-client-id.apps.googleusercontent.com
