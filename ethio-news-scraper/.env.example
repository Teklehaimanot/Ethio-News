# docker-compose overrides MONGO_URI to mongodb://mongo:27017/ndmc-mobile
MONGO_URI=mongodb://mongo:27017/ndmc-mobile

DEFAULT_NEWS_IMAGE=https://via.placeholder.com/800x450?text=Ethio+News

CRON_HOURS=6,10,14,18,22
RUN_ON_START=false

REQUEST_TIMEOUT=30
REQUEST_DELAY_SECONDS=1.5
FUZZY_TITLE_THRESHOLD=88
DEDUP_LOOKBACK_HOURS=72

# Optional Telegram
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=sessions/ethio_news_scraper
TELEGRAM_CHANNELS=tikvahethiopia
TELEGRAM_MESSAGE_LIMIT=30

# Set via compose root .env as well
INGEST_API_TOKEN=generate-a-long-random-secret
SCRAPER_API_PORT=8080
